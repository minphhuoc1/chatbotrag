# LLM Provider
LEGAL_CHATBOT_LLM_PROVIDER=groq

# Groq API key (required when provider=groq)
GROQ_API_KEY=gsk_your_key_here

# Models
# Tiered setup: Reasoner lớn, Analyzer/Intent nhẹ.
LEGAL_CHATBOT_REASONER_MODEL=openai/gpt-oss-20b
LEGAL_CHATBOT_ANALYZER_MODEL=llama-3.1-8b-instant
LEGAL_CHATBOT_INTENT_MODEL=llama-3.1-8b-instant

# Tiered fallback for lightweight calls (intent/analyzer) when primary model hits rate limit.
LEGAL_CHATBOT_ANALYZER_FALLBACK_MODEL=llama-3.1-8b-instant
LEGAL_CHATBOT_INTENT_FALLBACK_MODEL=llama-3.1-8b-instant
LEGAL_CHATBOT_FAST_MAX_RETRIES=0

# Reasoner fallback (only when primary model rate-limited/unavailable)
LEGAL_CHATBOT_REASONER_FALLBACK_MODEL=llama-3.1-8b-instant
LEGAL_CHATBOT_REASONER_MAX_RETRIES=0

# Optional runtime tuning
LEGAL_CHATBOT_LLM_TEMPERATURE=0.1
LEGAL_CHATBOT_LLM_TIMEOUT=60
LEGAL_CHATBOT_REASONER_MAX_TOKENS=768
LEGAL_CHATBOT_ANALYZER_MAX_TOKENS=256
LEGAL_CHATBOT_INTENT_MAX_TOKENS=128
LEGAL_CHATBOT_REASONER_MAX_CONTEXT_DOCS=6
LEGAL_CHATBOT_REASONER_MAX_CONTEXT_CHARS=6500

# Retrieval/embedding
LEGAL_CHATBOT_TOP_K=6
LEGAL_CHATBOT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LEGAL_CHATBOT_EMBED_DEVICE=auto
LEGAL_CHATBOT_RETRIEVAL_ENABLE_STRATEGY_ROUTER=true
LEGAL_CHATBOT_RETRIEVAL_ENABLE_LEXICAL=true
LEGAL_CHATBOT_RETRIEVAL_MAX_QUERY_VARIANTS=3
LEGAL_CHATBOT_RETRIEVAL_RRF_K=60
LEGAL_CHATBOT_RETRIEVAL_ENABLE_DETERMINISTIC_ARTICLE_BRANCH=true
LEGAL_CHATBOT_RETRIEVAL_ENABLE_RERANKER=true
LEGAL_CHATBOT_RETRIEVAL_ENABLE_METADATA_BOOST=true
LEGAL_CHATBOT_RETRIEVAL_RERANK_CANDIDATE_POOL=14

# PDF ingest backend
LEGAL_CHATBOT_PDF_BACKEND=opendataloader_json
LEGAL_CHATBOT_PREPROCESSED_DIR=data/preprocessed

# Optional: approved hints JSON (merged with hard-coded hints)
LEGAL_CHATBOT_HINTS_APPROVED_PATH=artifacts/hints/approved_hints.json

# ===== Third-party Observability & QA =====
# LangSmith trace (run-level tracing in LangChain)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=legal-chatbot-rag

# Langfuse trace
LEGAL_CHATBOT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Phoenix local tracing (OpenInference)
LEGAL_CHATBOT_PHOENIX_ENABLED=false
LEGAL_CHATBOT_PHOENIX_AUTO_INSTRUMENT=true
LEGAL_CHATBOT_PHOENIX_PROJECT=legal-chatbot-rag

# Optional trace tag to group runs across tools
LEGAL_CHATBOT_TRACE_TAG=dev

# Third-party QA runner toggles
ENABLE_RAGAS=true
ENABLE_TRULENS=true
ENABLE_LANGSMITH_DATASET_SYNC=true
ENABLE_LANGFUSE_DATASET_SYNC=true
THIRD_PARTY_QA_DATASET=legal-chatbot-rag-cases

# Ragas mode:
# - non_llm (recommended): stable, no LLM API calls for metrics.
# - llm: richer judge metrics but phụ thuộc API/rate-limit.
RAGAS_METRIC_MODE=non_llm

# Optional: run third-party metrics from an existing report (skip prediction/runtime init)
# THIRD_PARTY_SOURCE_REPORT=reports/third_party/third_party_eval_YYYYMMDD_HHMMSS.json

# Optional: third-party site-packages path if installed outside default interpreter
# THIRD_PARTY_VENDOR_PATH=D:\chatbotrag\.vendor\Lib\site-packages

# Vendor-path usage strategy (important for Windows stability):
# - Ragas often stable without vendor path
# - TruLens may require vendor path (if installed there)
RAGAS_USE_VENDOR_PATH=false
TRULENS_USE_VENDOR_PATH=true

# Ragas runtime tuning (recommended for Groq free-tier stability)
RAGAS_EVAL_MODEL=llama-3.1-8b-instant
RAGAS_EVAL_MAX_TOKENS=2048
RAGAS_RESPONSE_RELEVANCY_STRICTNESS=1
RAGAS_MAX_WORKERS=1
RAGAS_MAX_RETRIES=1
RAGAS_RUNTIME_ATTEMPTS=2
RAGAS_TIMEOUT_SECONDS=120
RAGAS_MAX_CONTEXTS=2
RAGAS_MAX_CONTEXT_CHARS=900
RAGAS_MAX_ANSWER_CHARS=1400
RAGAS_MAX_REFERENCE_CHARS=1600
RAGAS_MAX_REFERENCE_CONTEXTS=2
RAGAS_MAX_REFERENCE_CONTEXT_CHARS=900

# TruLens provider config
# auto -> thử OpenAI provider trước, rồi mới fallback litellm
TRULENS_METRIC_MODE=ground_truth
TRULENS_PROVIDER=auto
TRULENS_OPENAI_MODEL=llama-3.1-8b-instant
TRULENS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# TRULENS_OPENAI_API_KEY=...
TRULENS_RUNTIME_ATTEMPTS=2
TRULENS_MAX_CONTEXTS=2
TRULENS_MAX_CONTEXT_CHARS=800
TRULENS_NLTK_DATA_DIR=D:\chatbotrag\tmp\nltk_data
